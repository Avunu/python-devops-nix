{
	"name": "{release_label} (release automation only)",
	"target": "branch",
	"enforcement": "active",
	"conditions": { "ref_name": { "include": ["{release_pattern}"], "exclude": [] } },
	"bypass_actors": "{release_bypass}",
	"rules": [
		{ "type": "creation" },
		{ "type": "update", "parameters": { "update_allows_fetch_and_merge": false } },
		{ "type": "deletion" },
		{ "type": "non_fast_forward" }
	]
}
