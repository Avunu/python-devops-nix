name: ci
on:
  push:
    branches: [{{ branches.integration }}]
  pull_request:
  workflow_dispatch:
permissions: {}
jobs:
{% for gate in gates %}
  {{ gate }}:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: {{ pin("actions/checkout", "11bd71901bbe5b1630ceea73d27597364c9af683", "v4.2.2") }}
        with:
          persist-credentials: false
      - run: nix develop --no-pure-eval -c stub-nix ci {{ gate }}
{% endfor %}
