root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,toml,json,sh}]
indent_style = {{ cfg.editorconfig.indent }}
indent_size = 4
max_line_length = {{ cfg.editorconfig["line-length"] }}

[*.{yml,yaml,nix}]
indent_style = space
indent_size = 2

