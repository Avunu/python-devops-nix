/* The TUI's layout. Colours are the theme's ($primary, $accent, …), so a
   user's textual theme (ctrl+p → theme) carries through. */

#home-banner {
    padding: 1 2 0 2;
}

#home-stack, #home-site {
    padding: 0 2;
}

#home-actions {
    height: auto;
    padding: 1 2;
}

#home-actions Button, #stack-actions Button, #cmd-buttons Button, #store-cart Button {
    margin-right: 1;
    width: auto;
}

#home-keys {
    padding: 0 2;
}

/* Stack */

#stack-summary {
    padding: 0 1;
    height: 1;
}

#stack-main {
    height: 1fr;
}

#stack-table {
    width: 2fr;
    height: 1fr;
}

#stack-log {
    width: 3fr;
    height: 1fr;
    border: round $primary-darken-2;
}

#stack-actions {
    height: auto;
    padding: 0 1;
}

/* Commands */

#cmd-left {
    width: 1fr;
    min-width: 30;
}

#cmd-tree {
    height: 1fr;
}

#cmd-right {
    width: 2fr;
    padding: 0 2;
}

#cmd-title {
    padding-top: 1;
}

#cmd-help {
    padding: 1 0;
    color: $text-muted;
}

#cmd-form {
    height: auto;
}

#cmd-form Input, #cmd-form Select {
    margin-bottom: 1;
}

#cmd-buttons {
    height: auto;
    padding-top: 1;
}

.preview {
    padding: 1;
    background: $boost;
}

/* Store */

#store-top {
    height: auto;
}

#store-search {
    width: 1fr;
}

#store-category {
    width: 36;
}

#store-main {
    height: 1fr;
}

#store-filters {
    width: 30;
    height: 1fr;
}

#store-table {
    width: 3fr;
    height: 1fr;
}

#store-side {
    width: 2fr;
    height: 1fr;
    border-left: tall $primary-darken-2;
}

#store-detail {
    padding: 0 1;
}

#store-cart {
    height: auto;
    padding: 0 1;
}

#store-cart-text {
    width: 1fr;
    padding: 1 0;
}

/* Dialogs: confirm, form, run */

ConfirmScreen, FormScreen, RunScreen {
    align: center middle;
}

.dialog {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.dialog.wide {
    width: 95%;
    max-width: 200;
    height: 90%;
}

.dialog-title {
    text-style: bold;
    padding-bottom: 1;
}

.dialog-notes {
    padding-bottom: 1;
}

.dialog-commands {
    height: auto;
    max-height: 20;
    padding: 1;
    background: $boost;
}

.dialog-buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: right;
}

.dialog-buttons Button {
    margin-left: 1;
}

#run-log {
    height: 1fr;
    border: round $primary-darken-2;
}

#run-status {
    width: 1fr;
    padding: 1 0;
}
